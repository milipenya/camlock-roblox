-- РАБОЧАЯ ЛОГИКА RED LIGHT GREEN LIGHT
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- Функция поиска куклы или звукового триггера в Ink Game
local function isRedLight()
    -- Сканируем workspace на наличие куклы или состояния звука/света
    -- В Ink Game состояние часто реплицируется через StringValue или String Attribute в workspace
    local stateObject = workspace:FindFirstChild("TrafficLight") or workspace:FindFirstChild("DollState") or workspace:FindFirstChild("LightState")
    
    if stateObject then
        if stateObject:IsA("StringValue") and (stateObject.Value == "Red" or stateObject.Value == "RedLight") then
            return true
        end
    end
    
    -- Альтернативный метод по глобальным атрибутам самой игры
    local map = workspace:FindFirstChild("Map") or workspace:FindFirstChild("CurrentMap")
    if map and map:GetAttribute("Light") == "Red" then
        return true
    end
    
    return false
end

RunService.Heartbeat:Connect(function()
    if not RLGLEnabled then return end
    
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    if isRedLight() then
        hrp.Anchored = true -- Намертво замораживаем физику, кукла не убьет
        RLGLStatus.Text = "Doll State: RED (Frozen)"
        RLGLStatus.TextColor3 = Color3.fromRGB(255, 50, 50)
    else
        hrp.Anchored = false -- Размораживаем, можно бежать
        RLGLStatus.Text = "Doll State: GREEN (Safe)"
        RLGLStatus.TextColor3 = Color3.fromRGB(50, 255, 50)
    end
end)
