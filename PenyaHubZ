-- CORE MECHANICS
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local VIM = game:GetService("VirtualInputManager")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- 1. Smart Knife Dodge Logic
local function checkKnifeAttacks()
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return false end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local enemyHrp = player.Character:FindFirstChild("HumanoidRootPart")
            local enemyAnimator = player.Character:FindFirstChildOfClass("Humanoid") and player.Character.Humanoid:FindFirstChildOfClass("Animator")
            
            if enemyHrp and enemyAnimator then
                local distance = (myHrp.Position - enemyHrp.Position).Magnitude
                if distance <= KNIFE_RANGE then
                    local activeTracks = enemyAnimator:GetPlayingAnimationTracks()
                    for _, track in ipairs(activeTracks) do
                        local animName = string.lower(track.Animation.Name or "")
                        if string.find(animName, "hit") or string.find(animName, "slash") or string.find(animName, "stab") or string.find(animName, "swing") then
                            return true
                        end
                    end
                end
            end
        end
    end
    return false
end

RunService.Heartbeat:Connect(function()
    if not DodgeEnabled or isDodging then return end
    
    if checkKnifeAttacks() then
        isDodging = true
        local tapX = Camera.ViewportSize.X * 0.85
        local tapY = Camera.ViewportSize.Y * 0.75
        
        VIM:SendMouseButtonEvent(tapX, tapY, 0, true, game, 1)
        task.wait(0.01)
        VIM:SendMouseButtonEvent(tapX, tapY, 0, false, game, 1)
        
        task.wait(0.5) 
        isDodging = false
    end
end)

-- 2. Glass Bridge ESP Logic
RunService.Heartbeat:Connect(function()
    if not GlassEnabled then return end
    
    -- Scans for glass platforms under workspace
    -- Real glass usually has distinct properties, names or attributes like "Fake" or "Real"
    local bridge = workspace:FindFirstChild("GlassBridge") or workspace:FindFirstChild("Bridge")
    if bridge then
        for _, part in ipairs(bridge:GetDescendants()) do
            if part:IsA("Part") or part:IsA("MeshPart") then
                -- Check standard naming conventions or custom attributes used by developers
                if string.find(string.lower(part.Name), "fake") or part:GetAttribute("Fake") == true then
                    part.Transparency = 0.8
                    part.Color = Color3.fromRGB(255, 0, 0) -- Fake glass turns translucent red
                    part.CanCollide = false -- Extra protection so you don't accidentally step on it
                elseif string.find(string.lower(part.Name), "real") or part:GetAttribute("Real") == true then
                    part.Color = Color3.fromRGB(0, 255, 0) -- Safe glass turns green
                end
            end
        end
    end
end)

-- 3. Honeycomb Micro-Clicker Logic
RunService.Heartbeat:Connect(function()
    if not HoneyEnabled or isClickingHoney then return end
    
    -- Look for Honeycomb mini-game interface element or UI line target
    local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    local honeyGui = playerGui and (playerGui:FindFirstChild("Honeycomb") or playerGui:FindFirstChild("HoneycombGui"))
    
    if honeyGui and honeyGui.Enabled then
        isClickingHoney = true
        
        -- Locates the precise center or specific click zone target
        local traceTarget = honeyGui:FindFirstChild("ClickZone") or honeyGui:FindFirstChild("Circle")
        if traceTarget and traceTarget.Visible then
            local targetPos = traceTarget.AbsolutePosition
            local targetSize = traceTarget.AbsoluteSize
            
            -- Calculate precise safe click coordinates based on UI position
            local clickX = targetPos.X + (targetSize.X / 2)
            local clickY = targetPos.Y + (targetSize.Y / 2)
            
            VIM:SendMouseButtonEvent(clickX, clickY, 0, true, game, 1)
            task.wait(0.01)
            VIM:SendMouseButtonEvent(clickX, clickY, 0, false, game, 1)
        end
        
        -- Calculated safe delay (30-60ms) to bypass server click limits (Anti-Spam)
        task.wait(math.random(35, 65) / 1000)
        isClickingHoney = false
    end
end)
