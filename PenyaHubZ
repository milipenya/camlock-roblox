-- Логика функций
local EspActive = false
local GlassActive = false
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Функция для Player ESP (создает легальную подсветку Highlight)
local function TogglePlayerESP()
    EspActive = not EspActive
    if EspActive then
        PlayerESPBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
        PlayerESPBtn.Text = "Player ESP: ON"
        StatusLabel.Text = "Players highlighted!"
        
        -- Подсвечиваем всех игроков на твоем экране
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                if not p.Character:FindFirstChild("PenyaESP") then
                    local hl = Instance.new("Highlight")
                    hl.Name = "PenyaESP"
                    hl.Parent = p.Character
                    hl.FillColor = Color3.fromRGB(0, 180, 255)
                    hl.FillTransparency = 0.5
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                end
            end
        end
    else
        PlayerESPBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
        PlayerESPBtn.Text = "Player ESP: OFF"
        -- Удаляем подсветку
        for _, p in pairs(Players:GetPlayers()) do
            if p.Character and p.Character:FindFirstChild("PenyaESP") then
                p.Character.PenyaESP:Destroy()
            end
        end
    end
end

-- Функция для Glass Bridge ESP (Ищет правильные стекла по названию/тегам в Ink Game)
local function ToggleGlassESP()
    GlassActive = not GlassActive
    if GlassActive then
        GlassBridgeBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
        GlassBridgeBtn.Text = "Glass Bridge ESP: ON"
        StatusLabel.Text = "Scanning bridge..."
        
        -- Сканируем карту на наличие стеклянных плит
        -- Большинство Squid Game режимов называют правильные стекла "Real" или "Safe"
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") and (v.Name:lower():match("real") or v.Name:lower():match("safe") or v.Name:lower():match("correct")) then
                local box = Instance.new("BoxHandleAdornment")
                box.Name = "PenyaGlass"
                box.Size = v.Size + Vector3.new(0.1, 0.1, 0.1)
                box.AlwaysOnTop = true
                box.ZIndex = 5
                box.Color3 = Color3.fromRGB(0, 255, 100) -- Зеленый цвет для правильного стекла
                box.Adornee = v
                box.Parent = v
            end
        end
    else
        GlassBridgeBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
        GlassBridgeBtn.Text = "Glass Bridge ESP: OFF"
        -- Удаляем подсветку стекол
        for _, v in pairs(workspace:GetDescendants()) do
            if v:FindFirstChild("PenyaGlass") then
                v.PenyaGlass:Destroy()
            end
        end
    end
end

PlayerESPBtn.MouseButton1Click:Connect(TogglePlayerESP)
GlassBridgeBtn.MouseButton1Click:Connect(ToggleGlassESP)