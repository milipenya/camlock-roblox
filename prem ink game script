local function IsGuard(char)
    if not char then return false end
    if char:FindFirstChild("GuardMask") or char:FindFirstChild("Mask") or char:FindFirstChild("Suit") then return true end
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Shirt") or child:IsA("Pants") then
            if string.find(string.lower(child.Name), "guard") then return true end
        end
    end
    return false
end

local function IsEnemy(targetPlayer)
    if not TeamCheckActive then return true end
    local myChar = LocalPlayer.Character
    local tarChar = targetPlayer.Character
    if not myChar or not tarChar then return true end
    return IsGuard(myChar) ~= IsGuard(tarChar)
end

local function HasPriority(char)
    if not char then return false end
    if char:FindFirstChildOfClass("Highlight") and char:FindFirstChildOfClass("Highlight").FillColor == Color3.fromRGB(255, 0, 0) then return true end
    if char:FindFirstChild("SelectionBox") or char:FindFirstChild("BoxHandleAdornment") then return true end
    for _, child in ipairs(char:GetDescendants()) do
        if child:IsA("BillboardGui") and (string.find(string.lower(child.Name), "arrow") or child:FindFirstChild("Arrow") or child:FindFirstChild("ImageLabel")) then return true end
    end
    return false
end

local function ClearTargetESP()
    if CurrentHighlight then CurrentHighlight:Destroy() CurrentHighlight = nil end
end

local function ApplyTargetESP(character)
    ClearTargetESP()
    if character and not FullESPActive then
        local Highlight = Instance.new("Highlight")
        Highlight.Parent = character
        Highlight.FillColor = Color3.fromRGB(255, 0, 0)
        Highlight.FillTransparency = 0.5
        Highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        Highlight.OutlineTransparency = 0
        CurrentHighlight = Highlight
    end
end

local function ClearFullESP()
    for _, hl in pairs(FullESPHighlights) do if hl then hl:Destroy() end end
    FullESPHighlights = {}
end

local function UpdateFullESP()
    if not FullESPActive then ClearFullESP() return end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and IsEnemy(player) then
            if not FullESPHighlights[player] or not FullESPHighlights[player].Parent then
                local Highlight = Instance.new("Highlight")
                Highlight.Parent = player.Character
                Highlight.FillColor = Color3.fromRGB(255, 0, 0)
                Highlight.FillTransparency = 0.6
                Highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
                Highlight.OutlineTransparency = 0
                FullESPHighlights[player] = Highlight
            end
        end
    end
end

local function GetBestTarget(checkFov)
    local BestTarget = nil
    local MaxScore = math.huge
    local Center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and IsEnemy(player) then
            local Hum = player.Character:FindFirstChildOfClass("Humanoid")
            if Hum and Hum.Health > 0 then
                local EnemyPart = player.Character:FindFirstChild(LockPart) or player.Character.HumanoidRootPart
                local ScreenPos, OnScreen = Camera:WorldToViewportPoint(EnemyPart.Position)
                local ScreenPos2D = Vector2.new(ScreenPos.X, ScreenPos.Y)
                local ScreenDist = (ScreenPos2D - Center).Magnitude
                local Dist = (LocalPlayer.Character.HumanoidRootPart.Position - EnemyPart.Position).Magnitude
                if checkFov and ScreenDist > FOVRadius then continue end
                local Score = ScreenDist + (Dist * 1.5)
                if HasPriority(player.Character) then Score = Score - 999999 end
                if OnScreen or not checkFov then
                    if Score < MaxScore then MaxScore = Score BestTarget = player.Character end
                end
            end
        end
    end
    return BestTarget
end

RunService.RenderStepped:Connect(function()
    local CenterX = Camera.ViewportSize.X / 2
    local CenterY = Camera.ViewportSize.Y / 2
    FOVCircle.Position = Vector2.new(CenterX, CenterY)
    FOVCircle.Radius = FOVRadius
    FOVCircle.Visible = IsAimbotActive
    if FullESPActive then UpdateFullESP() end
    if IsCamlockActive then
        local IsTargetValid = false
        if Target and Target:FindFirstChild(LockPart) then
            local p = Players:GetPlayerFromCharacter(Target)
            if p and IsEnemy(p) and Target:FindFirstChildOfClass("Humanoid").Health > 0 then IsTargetValid = true end
        end
        if not IsTargetValid then
            Target = GetBestTarget(false)
            if not Target then Camera.CameraType = Enum.CameraType.Custom ClearTargetESP() return else Camera.CameraType = Enum.CameraType.Scriptable ApplyTargetESP(Target) end
        end
        if Target and Target:FindFirstChild(LockPart) and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            Camera.CameraType = Enum.CameraType.Scriptable
            local MyRoot = LocalPlayer.Character.HumanoidRootPart
            local EnemyPart = Target[LockPart]
            local Direction = (MyRoot.Position - EnemyPart.Position).Unit
            local TargetCamPos = MyRoot.Position + (Direction * CamDistance) + Vector3.new(0, 4, 0)
            Camera.Focus = EnemyPart.CFrame
            if Smoothness == 1 then Camera.CFrame = CFrame.lookAt(TargetCamPos, EnemyPart.Position) else Camera.CFrame = Camera.CFrame:Lerp(CFrame.lookAt(TargetCamPos, EnemyPart.Position), Smoothness) end
            MyRoot.CFrame = MyRoot.CFrame:Lerp(CFrame.lookAt(MyRoot.Position, Vector3.new(EnemyPart.Position.X, MyRoot.Position.Y, EnemyPart.Position.Z)), Smoothness)
            if not FullESPActive and (not CurrentHighlight or CurrentHighlight.Parent ~= Target) then ApplyTargetESP(Target) end
        end
    end
    if IsAimbotActive and not IsCamlockActive then
        local ABTarget = GetBestTarget(true)
        if ABTarget and ABTarget:FindFirstChild(LockPart) then
            local EnemyPart = ABTarget[LockPart]
            if Smoothness == 1 then Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, EnemyPart.Position) else Camera.CFrame = Camera.CFrame:Lerp(CFrame.lookAt(Camera.CFrame.Position, EnemyPart.Position), Smoothness * 0.5) end
        end
    end
end)

