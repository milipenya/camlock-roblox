local function GetBestTarget(useFOV)
    local BestTarget = nil
    local MaxScore = math.huge
    local Center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and IsEnemy(player) then
            local Hum = player.Character:FindFirstChildOfClass("Humanoid")
            if Hum and Hum.Health > 0 then
                local EnemyRoot = player.Character.HumanoidRootPart
                local ScreenPos, OnScreen = Camera:WorldToViewportPoint(EnemyRoot.Position)
                local Dist = (LocalPlayer.Character.HumanoidRootPart.Position - EnemyRoot.Position).Magnitude
                
                if OnScreen then
                    local ScreenDist = (Vector2.new(ScreenPos.X, ScreenPos.Y) - Center).Magnitude
                    
                    if not useFOV or (useFOV and ScreenDist <= FOVRadius) then
                        local hasPrio, prioScore = HasPriority(player.Character)
                        local Score = ScreenDist + (Dist * 1.5) - prioScore
                        
                        if Score < MaxScore then
                            MaxScore = Score
                            BestTarget = player.Character
                        end
                    end
                elseif not useFOV then
                    local hasPrio, prioScore = HasPriority(player.Character)
                    local Score = 2000 + Dist - prioScore
                    if Score < MaxScore then
                        MaxScore = Score
                        BestTarget = player.Character
                    end
                end
            end
        end
    end
    return BestTarget
end

local function StartLock()
    if Connection then Connection:Disconnect() end
    
    Connection = RunService.RenderStepped:Connect(function()
        if FullESPActive then UpdateFullESP() end
        FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        
        if not IsActive and not AimbotActive then
            if Connection then Connection:Disconnect() end
            Camera.CameraType = Enum.CameraType.Custom
            ClearTargetESP()
            return
        end
        
        local IsTargetValid = false
        if Target and Target:FindFirstChild(LockPart) then
            local targetPlayer = Players:GetPlayerFromCharacter(Target)
            local Hum = Target:FindFirstChildOfClass("Humanoid")
            if Hum and Hum.Health > 0 and targetPlayer and IsEnemy(targetPlayer) then
                if AimbotActive then
                    local ScreenPos, OnScreen = Camera:WorldToViewportPoint(Target[LockPart].Position)
                    if OnScreen then
                        local Center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                        local ScreenDist = (Vector2.new(ScreenPos.X, ScreenPos.Y) - Center).Magnitude
                        if ScreenDist <= FOVRadius then
                            IsTargetValid = true
                        end
                    end
                else
                    IsTargetValid = true
                end
            end
        end
        
        if not IsTargetValid then
            Target = GetBestTarget(AimbotActive)
            if not Target then
                if IsActive then Camera.CameraType = Enum.CameraType.Custom end
                ClearTargetESP()
            else
                if IsActive then Camera.CameraType = Enum.CameraType.Scriptable end
                if not AimbotActive then ApplyTargetESP(Target) end
            end
        end
        
        if Target and Target:FindFirstChild(LockPart) and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local MyRoot = LocalPlayer.Character.HumanoidRootPart
            local EnemyPart = Target[LockPart]
            local MyPos = MyRoot.Position
            local EnemyPos = EnemyPart.Position
            
            if IsActive then
                local Direction = (MyPos - EnemyPos).Unit
                local TargetCamPos = MyPos + (Direction * CamDistance) + Vector3.new(0, 4, 0)
                Camera.Focus = EnemyPart.CFrame
                
                if Smoothness == 1 then
                    Camera.CFrame = CFrame.lookAt(TargetCamPos, EnemyPos)
                else
                    Camera.CFrame = Camera.CFrame:Lerp(CFrame.lookAt(TargetCamPos, EnemyPos), Smoothness)
                end
                
                local LookVector = Vector3.new(EnemyPos.X, MyPos.Y, EnemyPos.Z)
                MyRoot.CFrame = MyRoot.CFrame:Lerp(CFrame.lookAt(MyPos, LookVector), Smoothness)
                
                if not FullESPActive then
                    if not CurrentHighlight or CurrentHighlight.Parent ~= Target then
                        ApplyTargetESP(Target)
                    end
                end
            elseif AimbotActive then
                local ScreenPos, OnScreen = Camera:WorldToViewportPoint(EnemyPos)
                if OnScreen then
                    local Center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                    local MousePos = UserInputService:GetMouseLocation()
                    local Diff = (Vector2.new(ScreenPos.X, ScreenPos.Y) - MousePos)
                    
                    if typeof(mousemoverel) == "function" then
                        mousemoverel(Diff.X * 0.25, Diff.Y * 0.25)
                    end
                end
            end
        end
    end)
end

