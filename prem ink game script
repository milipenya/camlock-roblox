        AimToggleButton.Text = "AIMBOT LOCK: OFF"
        AimToggleButton.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    end
end

local function StartLock()
    if Connection then Connection:Disconnect() end
    Camera.CameraType = Enum.CameraType.Scriptable
    
    Connection = RunService.RenderStepped:Connect(function()
        if FullESPActive then UpdateFullESP() end
        if not IsActive then
            if Connection then Connection:Disconnect() end
            Camera.CameraType = Enum.CameraType.Custom
            ClearTargetESP()
            return
        end
        
        local IsTargetValid = false
        if Target and Target:FindFirstChild(LockPart) then
            local targetPlayer = Players:GetPlayerFromCharacter(Target)
            local Hum = Target:FindFirstChildOfClass("Humanoid")
            if Hum and Hum.Health > 0 and targetPlayer and IsEnemy(targetPlayer) then IsTargetValid = true end
        end
        
        if IsTargetValid and not HasPriority(Target) then
            local bestNow = GetBestTarget()
            if bestNow and HasPriority(bestNow) then IsTargetValid = false end
        end
        
        if not IsTargetValid then
            Target = GetBestTarget()
            if not Target then
                Camera.CameraType = Enum.CameraType.Custom
                ClearTargetESP()
                return
            else
                Camera.CameraType = Enum.CameraType.Scriptable
                ApplyTargetESP(Target)
            end
        end
        
        if Target and Target:FindFirstChild(LockPart) and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local MyRoot = LocalPlayer.Character.HumanoidRootPart
            local EnemyPart = Target[LockPart]
            local MyPos = MyRoot.Position
            local EnemyPos = EnemyPart.Position
            local Direction = (MyPos - EnemyPos).Unit
            local TargetCamPos = MyPos + (Direction * CamDistance) + Vector3.new(0, 4, 0)
            
            Camera.Focus = EnemyPart.CFrame
            if Smoothness == 1 then
                Camera.CFrame = CFrame.lookAt(TargetCamPos, EnemyPos)
            else
                Camera.CFrame = Camera.CFrame:Lerp(CFrame.lookAt(TargetCamPos, EnemyPos), Smoothness)
            end
            
            local LookVector = Vector3.new(EnemyPos.X, MyPos.Y, EnemyPos.Z)
            MyRoot.CFrame = MyRoot.CFrame:Lerp(CFrame.lookAt(MyPos, LookVector), Smoothness)
            
            if not FullESPActive then
                if not CurrentHighlight or CurrentHighlight.Parent ~= Target then ApplyTargetESP(Target) end
            end
        end
    end)
end

local function ToggleState()
    IsActive = not IsActive
    SyncUI(IsActive)
    if IsActive then
        Target = GetBestTarget()
        if Target then ApplyTargetESP(Target) end
        StartLock()
    else
        Target = nil
        Camera.CameraType = Enum.CameraType.Custom
        ClearTargetESP()
    end
end

