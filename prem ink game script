local function HasPriority(char)
    if char:FindFirstChildOfClass("Highlight") then return true end
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Highlight") then return true end
    end
    local head = char:FindFirstChild("Head")
    if head then
        for _, c in ipairs(head:GetChildren()) do
            if c:IsA("BillboardGui") or c:IsA("Attachment") then return true end
        end
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        for _, c in ipairs(hrp:GetChildren()) do
            if c:IsA("BillboardGui") or c:IsA("Attachment") or c:IsA("Decal") then return true end
        end
    end
    return false
end

local function GetBestTarget()
    local PriorityTarget = nil
    local PriorityMaxScore = math.huge
    local RegularTarget = nil
    local RegularMaxScore = math.huge
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and IsEnemy(player) then
            local Hum = player.Character:FindFirstChildOfClass("Humanoid")
            if Hum and Hum.Health > 0 then
                local EnemyRoot = player.Character.HumanoidRootPart
                local ScreenPos, OnScreen = Camera:WorldToViewportPoint(EnemyRoot.Position)
                local Dist = (LocalPlayer.Character.HumanoidRootPart.Position - EnemyRoot.Position).Magnitude
                
                local ScreenDist = 2000
                if OnScreen then
                    local MousePos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                    ScreenDist = (Vector2.new(ScreenPos.X, ScreenPos.Y) - MousePos).Magnitude
                end
                
                local Score = ScreenDist + (Dist * 2)
                if not OnScreen then Score = Score + 1500 end
                
                if HasPriority(player.Character) then
                    if Score < PriorityMaxScore then PriorityMaxScore = Score PriorityTarget = player.Character end
                else
                    if Score < RegularMaxScore then RegularMaxScore = Score RegularTarget = player.Character end
                end
            end
        end
    end
    return PriorityTarget or RegularTarget
end

