local function GetInkGameTeam(player)
    if not player or not player.Character then return "Unknown" end
    local char = player.Character
    
    if char:FindFirstChild("Guard") or char:FindFirstChild("GuardMask") or char:FindFirstChild("Mask") or char:FindFirstChild("Suit") then
        return "Guard"
    end
    
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("BasePart") or child:IsA("MeshPart") then
            if child.Name == "Guard" or string.find(string.lower(child.Name), "mask") or string.find(string.lower(child.Name), "guard") then
                return "Guard"
            end
        end
        if child:IsA("Shirt") or child:IsA("Pants") then
            local id = child.ShirtTemplate or child.PantsTemplate or ""
            if string.find(string.lower(id), "guard") or string.find(string.lower(id), "pink") or string.find(string.lower(id), "red") then
                return "Guard"
            end
        end
    end
    
    local team = player.Team
    if team then
        local tName = string.lower(team.Name)
        if string.find(tName, "guard") or string.find(tName, "staff") or string.find(tName, "pink") or string.find(tName, "red") then
            return "Guard"
        end
        if string.find(tName, "player") or string.find(tName, "participant") or string.find(tName, "green") then
            return "Player"
        end
    end
    
    return "Player"
end

local function IsEnemy(targetPlayer)
    if not TeamCheckActive then return true end
    local myTeam = GetInkGameTeam(LocalPlayer)
    local enemyTeam = GetInkGameTeam(targetPlayer)
    return myTeam ~= enemyTeam
end

local function HasPriority(character)
    if not character then return false, 0 end
    local score = 0
    local isPriority = false
    
    if character:FindFirstChildOfClass("Highlight") then
        local hl = character:FindFirstChildOfClass("Highlight")
        if hl.Enabled and (hl.FillColor == Color3.fromRGB(255, 0, 0) or hl.OutlineColor == Color3.fromRGB(255, 0, 0)) then
            score = score + 5000
            isPriority = true
        end
    end
    
    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("BillboardGui") or child:IsA("SurfaceGui") then
            score = score + 3000
            isPriority = true
        end
        if child.Name == "Attachment" and child:FindFirstChildOfClass("BillboardGui") then
            score = score + 3000
            isPriority = true
        end
        if child:IsA("BasePart") and child:FindFirstChildOfClass("SelectionBox") then
            score = score + 4000
            isPriority = true
        end
    end
    
    local head = character:FindFirstChild("Head")
    if head then
        for _, c in ipairs(head:GetChildren()) do
            if c:IsA("BillboardGui") or c.Name == "Arrow" or c.Name == "Pointer" then
                score = score + 4000
                isPriority = true
            end
        end
    end
    
    return isPriority, score
end

local function ClearTargetESP() if CurrentHighlight then CurrentHighlight:Destroy() CurrentHighlight = nil end end
local function ApplyTargetESP(character)
    ClearTargetESP()
    if character and not FullESPActive then
        local Highlight = Instance.new("Highlight")
        Highlight.Parent = character
        Highlight.FillColor = Color3.fromRGB(255, 0, 0)
        Highlight.FillTransparency = 0.5
        Highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        Highlight.OutlineTransparency = 0
        CurrentHighlight = Highlight
    end
end

local function ClearFullESP() for _, hl in pairs(FullESPHighlights) do if hl then hl:Destroy() end end FullESPHighlights = {} end
local function UpdateFullESP()
    if not FullESPActive then ClearFullESP() return end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and IsEnemy(player) then
            if not FullESPHighlights[player] or not FullESPHighlights[player].Parent then
                local Highlight = Instance.new("Highlight")
                Highlight.Parent = player.Character
                Highlight.FillColor = Color3.fromRGB(255, 0, 0)
                Highlight.FillTransparency = 0.6
                Highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
                Highlight.OutlineTransparency = 0
                FullESPHighlights[player] = Highlight
            end
        end
    end
end

