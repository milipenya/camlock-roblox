local function IsEnemy(targetPlayer)
    if not TeamCheckActive then return true end
    if not LocalPlayer.Team or not targetPlayer.Team then return true end
    return LocalPlayer.Team ~= targetPlayer.Team
end

local function ClearTargetESP()
    if CurrentHighlight then CurrentHighlight:Destroy() CurrentHighlight = nil end
end

local function ApplyTargetESP(character)
    ClearTargetESP()
    if character and not FullESPActive then
        local Highlight = Instance.new("Highlight")
        Highlight.Parent = character
        Highlight.FillColor = Color3.fromRGB(255, 0, 0)
        Highlight.FillTransparency = 0.5
        Highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        Highlight.OutlineTransparency = 0
        CurrentHighlight = Highlight
    end
end

local function ClearFullESP()
    for _, hl in pairs(FullESPHighlights) do if hl then hl:Destroy() end end
    FullESPHighlights = {}
end

local function UpdateFullESP()
    if not FullESPActive then ClearFullESP() return end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and IsEnemy(player) then
            if not FullESPHighlights[player] or not FullESPHighlights[player].Parent then
                local Highlight = Instance.new("Highlight")
                Highlight.Parent = player.Character
                Highlight.FillColor = Color3.fromRGB(255, 0, 0)
                Highlight.FillTransparency = 0.6
                Highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
                Highlight.OutlineTransparency = 0
                FullESPHighlights[player] = Highlight
            end
        end
    end
end

