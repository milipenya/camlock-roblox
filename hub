local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

if CoreGui:FindFirstChild("FakePC_MouseEmulator") then
    CoreGui.FakePC_MouseEmulator:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "FakePC_MouseEmulator"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = CoreGui

-- ==========================================
-- 🖱️ ЭМУЛЯЦИЯ ВИРТУАЛЬНОГО КУРСОРЫ МЫШИ
-- ==========================================
local MouseCursor = Instance.new("Frame")
MouseCursor.Name = "VirtualCursor"
MouseCursor.Size = UDim2.new(0, 16, 0, 16)
MouseCursor.AnchorPoint = Vector2.new(0.5, 0.5)
MouseCursor.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
MouseCursor.BorderSizePixel = 1
MouseCursor.BorderColor3 = Color3.fromRGB(0, 0, 0)
MouseCursor.Visible = false
MouseCursor.Parent = ScreenGui

local CursorCorner = Instance.new("UICorner")
CursorCorner.CornerRadius = UDim.new(1, 0)
CursorCorner.Parent = MouseCursor

-- Отслеживание пальца/мыши для имитации кликов ПК
UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement then
        local pos = input.Position
        MouseCursor.Position = UDim2.new(0, pos.X, 0, pos.Y)
        MouseCursor.Visible = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        MouseCursor.Visible = false
    end
end)

-- ==========================================
-- 🎮 ПАНЕЛЬ УПРАВЛЕНИЯ (WASD + КНОПКИ ВНИЗУ)
-- ==========================================
local ControlPanel = Instance.new("Frame")
ControlPanel.Name = "PCControlPanel"
ControlPanel.Size = UDim2.new(0, 220, 0, 150)
ControlPanel.Position = UDim2.new(0.5, -110, 0.65, 0) -- Удобно внизу экрана
ControlPanel.BackgroundTransparency = 1
ControlPanel.Active = true
ControlPanel.Draggable = true -- Всю панель можно двигать
ControlPanel.Parent = ScreenGui

local keysPressed = { W = false, A = false, S = false, D = false }

local function CreateButton(name, text, size, pos, callback)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Size = size
    btn.Position = pos
    btn.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
    btn.BackgroundTransparency = 0.2
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 14
    btn.Parent = ControlPanel

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1.2
    stroke.Color = Color3.fromRGB(0, 170, 255)
    stroke.Parent = btn

    local function trigger(state)
        btn.BackgroundColor3 = state and Color3.fromRGB(0, 140, 220) or Color3.fromRGB(20, 20, 30)
        pcall(callback, state)
    end

    btn.MouseButton1Down:Connect(function() trigger(true) end)
    btn.MouseButton1Up:Connect(function() trigger(false) end)
    btn.TouchStarted:Connect(function() trigger(true) end)
    btn.TouchEnded:Connect(function() trigger(false) end)
end

-- Раскладка WASD в стиле ПК
CreateButton("W", "W", UDim2.new(0, 45, 0, 45), UDim2.new(0, 45, 0, 0), function(st) keysPressed.W = st end)
CreateButton("A", "A", UDim2.new(0, 45, 0, 45), UDim2.new(0, 0, 0, 48), function(st) keysPressed.A = st end)
CreateButton("S", "S", UDim2.new(0, 45, 0, 45), UDim2.new(0, 45, 0, 48), function(st) keysPressed.S = st end)
CreateButton("D", "D", UDim2.new(0, 45, 0, 45), UDim2.new(0, 90, 0, 48), function(st) keysPressed.D = st end)

-- Дополнительные кнопки (Space, Shift, E)
CreateButton("Space", "SPACE", UDim2.new(0, 135, 0, 32), UDim2.new(0, 0, 0, 98), function(st)
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then hum.Jump = st end
end)

CreateButton("E", "E", UDim2.new(0, 40, 0, 45), UDim2.new(0, 140, 0, 0), function(st)
    if st then
        for _, prompt in pairs(Workspace:GetDescendants()) do
            if prompt:IsA("ProximityPrompt") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = LocalPlayer.Character.HumanoidRootPart
                if (hrp.Position - prompt.Parent.Position).Magnitude <= (prompt.MaxActivationDistance + 15) then
                    fireproximityprompt(prompt)
                end
            end
        end
    end
end)

CreateButton("Shift", "SHIFT", UDim2.new(0, 75, 0, 32), UDim2.new(0, 140, 0, 98), function(st)
    LocalPlayer.DevEnableMouseLock = st
end)

-- Движение персонажа через виртуальные клавиши
RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        local moveDir = Vector3.new(0, 0, 0)
        local camFwd = Camera.CFrame.LookVector
        local camRight = Camera.CFrame.RightVector
        
        camFwd = Vector3.new(camFwd.X, 0, camFwd.Z).Unit
        camRight = Vector3.new(camRight.X, 0, camRight.Z).Unit
        
        if keysPressed.W then moveDir = moveDir + camFwd end
        if keysPressed.S then moveDir = moveDir - camFwd end
        if keysPressed.D then moveDir = moveDir + camRight end
        if keysPressed.A then moveDir = moveDir - camRight end
        
        if moveDir.Magnitude > 0 then
            hum:Move(moveDir.Unit, false)
        else
            hum:Move(Vector3.new(0, 0, 0), false)
        end
    end
end)

print("✅ Fake PC Layout с эмуляцией мыши успешно запущен!")
