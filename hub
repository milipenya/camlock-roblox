-- Состояния нажатий клавиш
local keysPressed = {
    W = false,
    A = false,
    S = false,
    D = false
}

local function CreateKey(name, text, size, pos, onStateChange)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Size = size
    btn.Position = pos
    btn.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
    btn.BackgroundTransparency = 0.3
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 15
    btn.Parent = PCFrame

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = btn

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1.5
    stroke.Color = Color3.fromRGB(0, 170, 255)
    stroke.Parent = btn

    local function trigger(state)
        btn.BackgroundColor3 = state and Color3.fromRGB(0, 140, 220) or Color3.fromRGB(20, 20, 30)
        btn.BackgroundTransparency = state and 0.1 or 0.3
        if onStateChange then
            onStateChange(state)
        end
    end

    btn.MouseButton1Down:Connect(function() trigger(true) end)
    btn.MouseButton1Up:Connect(function() trigger(false) end)
    btn.TouchStarted:Connect(function() trigger(true) end)
    btn.TouchEnded:Connect(function() trigger(false) end)
end

-- Создаем WASD с привязкой к движению
CreateKey("W_Key", "W", UDim2.new(0, 45, 0, 45), UDim2.new(0, 45, 0, 0), function(state) keysPressed.W = state end)
CreateKey("A_Key", "A", UDim2.new(0, 45, 0, 45), UDim2.new(0, 0, 0, 45), function(state) keysPressed.A = state end)
CreateKey("S_Key", "S", UDim2.new(0, 45, 0, 45), UDim2.new(0, 45, 0, 45), function(state) keysPressed.S = state end)
CreateKey("D_Key", "D", UDim2.new(0, 45, 0, 45), UDim2.new(0, 90, 0, 45), function(state) keysPressed.D = state end)

-- Кнопка SPACE (Прыжок)
