local isTrolling = false
TrollFloatingBtn.MouseButton1Click:Connect(function()
    if isTrolling then return end
    isTrolling = true

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        isTrolling = false
        return
    end

    local lookVec = hrp.CFrame.LookVector
    local speed = 18
    local reps = 3 -- 3 движения вперед-назад

    for i = 1, reps do
        local startTime = tick()
        while tick() - startTime < 0.12 do
            hrp.AssemblyLinearVelocity = Vector3.new(lookVec.X * speed, hrp.AssemblyLinearVelocity.Y, lookVec.Z * speed)
            RunService.RenderStepped:Wait()
        end

        startTime = tick()
        while tick() - startTime < 0.12 do
            hrp.AssemblyLinearVelocity = Vector3.new(-lookVec.X * speed, hrp.AssemblyLinearVelocity.Y, -lookVec.Z * speed)
            RunService.RenderStepped:Wait()
        end
    end

    hrp.AssemblyLinearVelocity = Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0)
    isTrolling = false
end)

-- ==========================================
-- 🔄 ОСНОВНОЙ ИГРОВОЙ ЦИКЛ (RENDERSTEPPED)
-- ==========================================
RunService.RenderStepped:Connect(function()
    -- Отрисовка FOV Аима
    FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    FOVCircle.Radius = Config.Aimbot.FOV
    FOVCircle.Visible = Config.Aimbot.Enabled

    -- 🎯 Логика Аимбота
    if Config.Aimbot.Enabled then
        local target = GetTarget(Config.Aimbot.TargetMode, Config.Aimbot.FOV)
        if target and target.Character and target.Character:FindFirstChild("Head") then
            local head = target.Character.Head
            local hrp = target.Character:FindFirstChild("HumanoidRootPart")
            local targetPos = head.Position

            -- Предикшн движения
            if hrp and hrp.AssemblyLinearVelocity.Magnitude > 0.1 then
                local dist = (head.Position - Camera.CFrame.Position).Magnitude
                targetPos = head.Position + (hrp.AssemblyLinearVelocity * (dist / 1000) * Config.Aimbot.Prediction)
            end

            -- Плавное доведение
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, targetPos), 0.2)
        end
    end

    -- 🎥 Логика Камлока (Вращение И Камеры, И Персонажа + Подсветка)
    if Config.Camlock.Active and Config.Camlock.Target and Config.Camlock.Target.Character then
        local targetChar = Config.Camlock.Target.Character
        local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
        local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

        if targetHRP then
            -- Включаем подсветку цели
            TargetHighlight.Adornee = targetChar
            TargetHighlight.Enabled = true

            -- Поворачиваем камеру на цель
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHRP.Position)

            -- Поворачиваем самого персонажа на цель
            if myHRP then
                myHRP.CFrame = CFrame.new(myHRP.Position, Vector3.new(targetHRP.Position.X, myHRP.Position.Y, targetHRP.Position.Z))
            end
        else
            TargetHighlight.Enabled = false
        end
    else
        TargetHighlight.Enabled = false
    end
end)

