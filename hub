-- ==========================================
-- ИГРОВОЙ ЦИКЛ (РЕНДЕР)
-- ==========================================
RunService.RenderStepped:Connect(function()
    FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    FOVCircle.Radius = Config.Aimbot.FOV
    FOVCircle.Visible = Config.Aimbot.Enabled

    -- Аимбот
    if Config.Aimbot.Enabled then
        local target = GetTarget(Config.Aimbot.TargetMode, Config.Aimbot.FOV)
        if target and target.Character and target.Character:FindFirstChild("Head") then
            local head = target.Character.Head
            local hrp = target.Character:FindFirstChild("HumanoidRootPart")
            local targetPos = head.Position
            if hrp and hrp.AssemblyLinearVelocity.Magnitude > 0.1 then
                local dist = (head.Position - Camera.CFrame.Position).Magnitude
                targetPos = head.Position + (hrp.AssemblyLinearVelocity * (dist / 1000) * Config.Aimbot.Prediction)
            end
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, targetPos), 0.2)
        end
    end

    -- Идеальный Камлок (Камера держит в фокусе и тебя, и врага, а персонаж смотрит на цель)
    if Config.Camlock.Active and Config.Camlock.Target and Config.Camlock.Target.Character then
        local targetChar = Config.Camlock.Target.Character
        local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
        local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

        if targetHRP and myHRP then
            TargetHighlight.Adornee = targetChar
            TargetHighlight.Enabled = true

            -- Поворачиваем твоего персонажа на врага
            myHRP.CFrame = CFrame.new(myHRP.Position, Vector3.new(targetHRP.Position.X, myHRP.Position.Y, targetHRP.Position.Z))

            -- Ставим камеру сзади твоего персонажа, но направляем её так, чтобы и ты, и враг были видны на экране
            local midPoint = (myHRP.Position + targetHRP.Position) / 2
            local camPos = myHRP.Position - (myHRP.CFrame.LookVector * 6) + Vector3.new(0, 4, 0)
            Camera.CFrame = CFrame.new(camPos, targetHRP.Position)
        else
            TargetHighlight.Enabled = false
        end
    else
        TargetHighlight.Enabled = false
    end
end)

