-- ==========================================
-- 🎯 2. SMART AIMBOT WITH PREDICTION (Про-аим)
-- ==========================================
local aimbotEnabled = false
local aimFOV = 120 -- Радиус действия аима

local FOVCircle = Drawing.new("Circle")
FOVCircle.Thickness = 1.5
FOVCircle.Color = Color3.fromRGB(0, 170, 255)
FOVCircle.Transparency = 0.6
FOVCircle.Filled = false
FOVCircle.Visible = false

local function GetClosestPlayer()
    local closestPlayer = nil
    local shortestDistance = aimFOV

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") and player.Character:FindFirstChildOfClass("Humanoid") then
            local hum = player.Character:FindFirstChildOfClass("Humanoid")
            if hum.Health > 0 then
                local head = player.Character.Head
                local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                
                if onScreen then
                    local mousePos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    
                    if dist < shortestDistance then
                        shortestDistance = dist
                        closestPlayer = player
                    end
                end
            end
        end
    end
    return closestPlayer
end

RunService.RenderStepped:Connect(function()
    FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    FOVCircle.Radius = aimFOV
    FOVCircle.Visible = aimbotEnabled

    if aimbotEnabled then
        local target = GetClosestPlayer()
        if target and target.Character and target.Character:FindFirstChild("Head") then
            local head = target.Character.Head
            local hrp = target.Character:FindFirstChild("HumanoidRootPart")
            
            -- Умный Предикшн (учитывает скорость врага)
            local targetPos = head.Position
            if hrp and hrp.AssemblyLinearVelocity.Magnitude > 0.1 then
                local velocity = hrp.AssemblyLinearVelocity
                local distance = (head.Position - Camera.CFrame.Position).Magnitude
                local timeToHit = distance / 1000 -- Рассчитываем время полета пули
                targetPos = head.Position + (velocity * timeToHit * 1.25)
            end
            
            -- Плавное доведение (имитация про-игрока без резкого мгновенного магнита)
            local currentCFrame = Camera.CFrame
            local targetCFrame = CFrame.new(currentCFrame.Position, targetPos)
            Camera.CFrame = currentCFrame:Lerp(targetCFrame, 0.25)
        end
    end
end)

CreateMenuToggle("🎯 Smart Pro-Aimbot", function(state)
    aimbotEnabled = state
end)

