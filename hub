TrollBtn.Parent = ScreenGui

local TCorner = Instance.new("UICorner")
TCorner.CornerRadius = UDim.new(0, 8)
TCorner.Parent = TrollBtn

local TStroke = Instance.new("UIStroke")
TStroke.Thickness = 1.5
TStroke.Color = Color3.fromRGB(255, 0, 128)
TStroke.Parent = TrollBtn

local isTrolling = false
TrollBtn.MouseButton1Click:Connect(function()
    if isTrolling then return end
    isTrolling = true
    
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then 
        isTrolling = false
        return 
    end
    
    local lookVec = hrp.CFrame.LookVector
    local speed = 15 -- Скорость рывка
    local reps = 3 -- 3 размашистых шага вперед-назад
    
    for i = 1, reps do
        -- Шаг вперед
        local startTime = tick()
        while tick() - startTime < 0.12 do
            hrp.AssemblyLinearVelocity = Vector3.new(lookVec.X * speed, hrp.AssemblyLinearVelocity.Y, lookVec.Z * speed)
            RunService.RenderStepped:Wait()
        end
        
        -- Шаг назад
        startTime = tick()
        while tick() - startTime < 0.12 do
            hrp.AssemblyLinearVelocity = Vector3.new(-lookVec.X * speed, hrp.AssemblyLinearVelocity.Y, -lookVec.Z * speed)
            RunService.RenderStepped:Wait()
        end
    end
    
    hrp.AssemblyLinearVelocity = Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0)
    isTrolling = false
end)

CreateMenuToggle("😈 Кнопка Troll Peek", function(state)
    TrollBtn.Visible = state
end)

