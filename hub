local function CreateKey(name, text, size, pos, callback)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Size = size
    btn.Position = pos
    btn.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
    btn.BackgroundTransparency = 0.3
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 15
    btn.Parent = PCFrame

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = btn

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1.5
    stroke.Color = Color3.fromRGB(0, 170, 255)
    stroke.Parent = btn

    local activeState = false
    local function trigger(state)
        activeState = state
        btn.BackgroundColor3 = activeState and Color3.fromRGB(0, 140, 220) or Color3.fromRGB(20, 20, 30)
        btn.BackgroundTransparency = activeState and 0.1 or 0.3
        pcall(callback, activeState)
    end

    btn.MouseButton1Down:Connect(function() trigger(true) end)
    btn.MouseButton1Up:Connect(function() trigger(false) end)
    btn.TouchStarted:Connect(function() trigger(true) end)
    btn.TouchEnded:Connect(function() trigger(false) end)
end

