local isTrolling = false
TrollFloatingBtn.MouseButton1Click:Connect(function()
    if isTrolling then return end
    isTrolling = true
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then isTrolling = false return end

    local lookVec = hrp.CFrame.LookVector
    local speed = 18
    for i = 1, 3 do
        local start = tick()
        while tick() - start < 0.12 do
            hrp.AssemblyLinearVelocity = Vector3.new(lookVec.X * speed, hrp.AssemblyLinearVelocity.Y, lookVec.Z * speed)
            RunService.RenderStepped:Wait()
        end
        start = tick()
        while tick() - start < 0.12 do
            hrp.AssemblyLinearVelocity = Vector3.new(-lookVec.X * speed, hrp.AssemblyLinearUnit and 0 or hrp.AssemblyLinearVelocity.Y, -lookVec.Z * speed)
            RunService.RenderStepped:Wait()
        end
    end
    hrp.AssemblyLinearVelocity = Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0)
    isTrolling = false
end)

-- Кружок FOV
local FOVCircle = Drawing.new("Circle")
FOVCircle.Thickness = 1.5
